{
  "manifest_version": 3,
  "name": "dsh-kite",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.0.7",
  "icons": {
    "128": "media/icon.png"
  },
  "action": {
    "default_title": "dsh-kite",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "media/icon.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://dsh.gaolin.ink/*"
  ]
}
